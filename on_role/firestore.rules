rules_version = '2';

// Regras de segurança do OnRolê:
// - só usuários logados leem dados;
// - cada usuário só escreve os próprios dados;
// - qualquer pessoa logada posta; o selo "no rolê agora" (atVenue) só é
//   aceito com presença ativa no local (check-in por geocerca);
// - nenhuma coleção guarda coordenadas: a presença é sempre por local.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validName(name) {
      return name is string && name.size() > 0 && name.size() <= 60;
    }

    // Presença renovada nos últimos 20 minutos no local informado.
    function hasActivePresenceAt(venueId) {
      let path = /databases/$(database)/documents/presence/$(request.auth.uid);
      return exists(path)
        && get(path).data.venueId == venueId
        && get(path).data.lastSeenAt > request.time - duration.value(20, 'm');
    }

    // Bio curta, até 8 gostos de rolê e foto enviada pela própria pessoa.
    function validProfile(data) {
      return validName(data.name)
        && (data.get('bio', null) == null || (data.bio is string && data.bio.size() <= 200))
        && data.get('interests', []) is list
        && data.get('interests', []).size() <= 8;
    }

    function validPhoto(photo) {
      return photo == null
        || (photo is map
          && photo.id is string
          && get(/databases/$(database)/documents/media/$(photo.id)).data.ownerId == request.auth.uid);
    }

    // Perfil público: nome, bio, foto, gostos e visitas por local (base do
    // match).
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasAll(['name', 'visits', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'bio', 'avatarUrl', 'photo', 'interests', 'visits', 'createdAt'])
        && validProfile(request.resource.data)
        && validPhoto(request.resource.data.get('photo', null))
        && request.resource.data.visits is map
        && request.resource.data.createdAt == request.time;
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'bio', 'avatarUrl', 'photo', 'interests', 'visits'])
        && validProfile(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['photo'])
          || validPhoto(request.resource.data.photo));
      allow delete: if false;

      // Dados que só o dono vê (e-mail, data de nascimento, consentimento do
      // experimento).
      match /private/{docId} {
        allow read, write: if isSelf(uid);
      }

      // Histórico de check-ins: só o dono.
      match /checkins/{checkInId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['venueId', 'checkedInAt', 'checkedOutAt'])
          && request.resource.data.venueId is string
          && request.resource.data.checkedInAt is timestamp
          && request.resource.data.checkedOutAt == null;
        allow update: if isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkedOutAt'])
          && request.resource.data.checkedOutAt is timestamp;
        allow delete: if false;
      }
    }

    // Onde cada usuário está agora (só o local). Alimenta a lotação do mapa;
    // o app renova lastSeenAt e presenças sem renovação deixam de contar.
    match /presence/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['venueId', 'since', 'lastSeenAt'])
        && request.resource.data.venueId is string
        && request.resource.data.since is timestamp
        && request.resource.data.lastSeenAt == request.time;
      allow delete: if isSelf(uid);
    }

    // Local marcado num post/story: livre ("bora no Boteco?"), mas o selo
    // "no rolê agora" exige presença ativa nele.
    function validVenueTag(data) {
      return (data.venueId == null || data.venueId is string)
        && data.atVenue is bool
        && (data.atVenue == false || hasActivePresenceAt(data.venueId));
    }

    // Curtir/descurtir: só muda likedBy, e só com o próprio id.
    function isLikeToggle() {
      let before = resource.data.get('likedBy', []).toSet();
      let after = request.resource.data.get('likedBy', []).toSet();
      let me = [request.auth.uid].toSet();
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
        && ((after.difference(before) == me && before.difference(after).size() == 0)
          || (before.difference(after) == me && after.difference(before).size() == 0));
    }

    // Nova resposta: o contador sobe 1 e lastReplyId aponta para uma resposta
    // criada no mesmo lote. Sem isso, qualquer um inflaria o contador.
    function isReplyAdded(postId) {
      let reply = /databases/$(database)/documents/posts/$(postId)/replies/$(request.resource.data.lastReplyId);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount', 'lastReplyId'])
        && request.resource.data.replyCount == resource.data.get('replyCount', 0) + 1
        && !exists(reply)
        && existsAfter(reply);
    }

    // Posts do feed: texto e/ou até 4 fotos/vídeos.
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['authorId', 'authorName', 'text', 'media', 'venueId', 'atVenue', 'likedBy', 'replyCount', 'createdAt'])
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'text', 'media', 'venueId', 'atVenue', 'likedBy', 'replyCount', 'createdAt'])
        && request.resource.data.authorId == request.auth.uid
        && validName(request.resource.data.authorName)
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && request.resource.data.media is list
        && request.resource.data.media.size() <= 4
        && (request.resource.data.text.size() > 0 || request.resource.data.media.size() > 0)
        && request.resource.data.likedBy == []
        && request.resource.data.replyCount == 0
        && request.resource.data.createdAt == request.time
        && validVenueTag(request.resource.data);
      allow update: if signedIn() && (isLikeToggle() || isReplyAdded(postId));
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /replies/{replyId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'text', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && validName(request.resource.data.authorName)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time
          // O contador do post sobe no mesmo lote (ver isReplyAdded).
          && getAfter(/databases/$(database)/documents/posts/$(postId)).data.lastReplyId == replyId;
        allow update, delete: if false;
      }
    }

    // Stories: uma foto ou vídeo que vale por 24 horas. Sem a exclusão
    // automática (TTL, do plano pago), o próprio autor apaga os vencidos.
    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'media', 'venueId', 'atVenue', 'createdAt', 'expiresAt'])
        && request.resource.data.authorId == request.auth.uid
        && validName(request.resource.data.authorName)
        && request.resource.data.media is map
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(25, 'h')
        && validVenueTag(request.resource.data);
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    // Fotos e vídeos guardados no próprio banco (o Cloud Storage exige o
    // plano pago): um documento de metadados e os bytes em pedaços.
    match /media/{mediaId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerId', 'kind', 'mimeType', 'size', 'chunkCount', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.kind in ['image', 'video']
        && request.resource.data.mimeType is string
        && request.resource.data.size is int
        && request.resource.data.size > 0
        && request.resource.data.size <= 10485760
        && request.resource.data.chunkCount is int
        && request.resource.data.chunkCount >= 1
        && request.resource.data.chunkCount <= 12
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      function mediaDoc() {
        return get(/databases/$(database)/documents/media/$(mediaId)).data;
      }

      // Cada pedaço só entra depois dos metadados, do mesmo dono e dentro da
      // quantidade declarada. Pedaços nunca são alterados.
      match /chunks/{index} {
        allow read: if signedIn();
        allow create: if signedIn()
          && mediaDoc().ownerId == request.auth.uid
          && int(index) < mediaDoc().chunkCount
          && request.resource.data.keys().hasOnly(['data'])
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 950000;
        allow delete: if signedIn() && mediaDoc().ownerId == request.auth.uid;
      }
    }

    // Conexões: seguir outra pessoa (sem precisar de reciprocidade). O id é
    // {de}_{para}, então existe um por par; quem segue quem é público para
    // quem está logado, como os perfis. Só quem segue cria ou desfaz.
    match /follows/{followId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasAll(['from', 'to', 'createdAt'])
        && request.resource.data.keys().hasOnly(['from', 'to', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.to
        && exists(/databases/$(database)/documents/users/$(request.resource.data.to))
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && resource.data.from == request.auth.uid;
    }

    // Match geossocial (pausado no app). swipes/{de}_{para} guarda cada decisão;
    // a fonte (afinidade ou controle) e a nota permitem comparar as duas
    // formas de sugestão no TCC (H3).
    match /swipes/{swipeId} {
      // As próprias decisões e, uma a uma, as curtidas recebidas: quem passou
      // e quem ainda não decidiu ficam iguais (acesso negado).
      allow get: if signedIn()
        && (resource.data.from == request.auth.uid
          || (resource.data.to == request.auth.uid && resource.data.decision == 'like'));
      allow list: if signedIn() && resource.data.from == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasAll(['from', 'to', 'decision', 'source', 'score', 'createdAt'])
        && request.resource.data.keys().hasOnly(['from', 'to', 'decision', 'source', 'score', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && swipeId == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.decision in ['like', 'pass']
        && request.resource.data.source in ['afinidade', 'controle']
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 1
        && request.resource.data.createdAt == request.time;
      allow delete: if false;
    }

    function likes(from, to) {
      let path = /databases/$(database)/documents/swipes/$(from + '_' + to);
      return existsAfter(path) && getAfter(path).data.decision == 'like';
    }

    // Match: só nasce com as duas curtidas gravadas (mesmo lote ou antes) e
    // nunca é alterado. O id é a dupla em ordem, então existe um por par.
    match /matches/{matchId} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['users', 'createdAt'])
        && request.resource.data.users is list
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users[0] < request.resource.data.users[1]
        && matchId == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && likes(request.resource.data.users[0], request.resource.data.users[1])
        && likes(request.resource.data.users[1], request.resource.data.users[0])
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Experimento de campo: lotes de eventos pseudônimos, sem coordenadas.
    // Só o participante envia, lê e apaga; a exportação usa o Admin SDK.
    match /telemetry/{uid}/batches/{batchId} {
      allow read, delete: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasAll(['events', 'count', 'createdAt'])
        && request.resource.data.keys().hasOnly(['events', 'count', 'createdAt'])
        && request.resource.data.events is list
        && request.resource.data.events.size() > 0
        && request.resource.data.events.size() <= 500
        && request.resource.data.count == request.resource.data.events.size()
        && request.resource.data.createdAt == request.time;
      allow update: if false;
    }
  }
}
